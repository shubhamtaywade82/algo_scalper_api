{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "ruby_lsp",
      "name": "Debug Rails Server",
      "request": "launch",
      "command": "bundle exec rails server -p 3011"
    },
    {
      "type": "ruby_lsp",
      "name": "Debug RSpec - Current File",
      "request": "launch",
      "command": "bundle exec rspec",
      "file": "${relativeFile}"
    },
    {
      "type": "ruby_lsp",
      "name": "Debug RSpec - Single Example",
      "request": "launch",
      "command": "bundle exec rspec",
      "file": "${relativeFile}:${lineNumber}"
    },
    {
      "type": "ruby_lsp",
      "name": "Attach to Debugger (rdbg)",
      "request": "attach"
    }
  ]
}
