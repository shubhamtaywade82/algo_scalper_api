#!/usr/bin/env bash
# frozen_string_literal: true

# Pre-push hook: update Woods codebase index before pushing.
# Runs incremental extraction so AI coding tools always see fresh context.

set -euo pipefail

echo "⟳ Updating Woods codebase index..."

if ! bundle exec rake woods:incremental 2>/dev/null; then
  echo "⚠ Woods incremental update failed (non-blocking)"
fi

echo "✓ Woods index updated"
