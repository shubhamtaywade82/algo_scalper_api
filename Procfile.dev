web: until bundle exec rails server -p 3011; do echo "[web] crashed (exit $?), restarting in 2s..."; sleep 2; done
trading: until ENABLE_TRADING_SERVICES=true bundle exec rake trading:daemon; do echo "[trading] crashed (exit $?), restarting in 2s..."; sleep 2; done
jobs: sh -c 'if [ "${ENABLE_JOBS:-true}" != "true" ]; then printf "jobs disabled (set ENABLE_JOBS=true to run)\n"; sleep infinity; fi; until bundle exec bin/jobs; do echo "[jobs] crashed (exit $?), restarting in 2s..."; sleep 2; done'
dashboard: cd dashboard && until npm run dev; do echo "[dashboard] crashed (exit $?), restarting in 2s..."; sleep 2; done
mcp: until bin/mcp; do echo "[mcp] crashed (exit $?), restarting in 2s..."; sleep 2; done
agent: bash -c 'set -o pipefail; if [ "${WITH_AGENT:-true}" != "true" ]; then printf "agent disabled (WITH_AGENT=false)\n"; sleep infinity; fi; LOG="$PWD/log/agent.log"; cd ../options-trading-agent || { echo "[agent] ../options-trading-agent not found"; sleep infinity; }; until env -i HOME="$HOME" PATH="$PATH" UI=off RAILS_INTENT_URL=http://127.0.0.1:3011 RAILS_INTENT_KEY="$API_OPERATOR_TOKEN" AGENT_SNAPSHOT_ENABLED=true DHAN_FEED_IST_SHIFTED=false npm run dev:paper 2>&1 | tee -a "$LOG"; do echo "[agent] exited ($?), restarting in 30s..." | tee -a "$LOG"; sleep 30; done'
