# Algo Scalper API - Example Environment Variables
#
# Copy this file to `.env` and fill in values as needed for your environment.
# These are development-friendly defaults. Do not commit real secrets.

########################################
# HTTP API security (optional in dev; set in production)
########################################
# When set, dashboard-style GET /api/* endpoints require:
#   Authorization: Bearer <token>   or   X-Api-Key: <token>
# ActionCable (/cable) accepts the same token as query ?token= or Bearer on connect.
#API_DASHBOARD_TOKEN=
# Vite dashboard (dashboard/): set the same value so the SPA can call the API
#VITE_API_DASHBOARD_TOKEN=

# When set, operator endpoints require Bearer or X-Api-Key (calibration apply,
# drawdown reset, public IP audit, settings update_ip, AI snapshot, SMC?ai=1).
#API_OPERATOR_TOKEN=

# Bulk algo overrides (PATCH /api/settings/bulk). Required in production if that
# route is reachable; use header X-Settings-Update-Token or param token.
#SETTINGS_UPDATE_TOKEN=

# Circuit breaker trip/reset (header X-Circuit-Breaker-Token or param token).
#CIRCUIT_BREAKER_TOKEN=

# Rack::Attack (config/initializers/rack_attack.rb; off in test). Defaults:
# 240 req / 5 min per IP on /api; 12 req / min on POST .../ai_snapshot.
#RACK_ATTACK_API_LIMIT=240
#RACK_ATTACK_API_PERIOD_SECONDS=300
#RACK_ATTACK_AI_LIMIT=12
#RACK_ATTACK_AI_PERIOD_SECONDS=60

# Mount RSwag UI + OpenAPI JSON at /api-docs in production (off by default).
#ENABLE_SWAGGER_UI=true

########################################
# Rails / Server
########################################
# Rails log level: debug, info, warn, error, fatal, unknown
RAILS_LOG_LEVEL=info

# Puma threads; coordinate with DB pool sizing
RAILS_MAX_THREADS=2

# HTTP port
PORT=3000

# Optional PID file path (used only if set)
#PIDFILE=tmp/pids/server.pid

# Run Solid Queue supervisor inside Puma (single-server). "true" to enable.
SOLID_QUEUE_IN_PUMA=false

# Set by CI; affects eager loading in test
#CI=false

########################################
# Background Jobs / Queue
########################################
# Number of Solid Queue processes (see config/queue.yml)
JOB_CONCURRENCY=1

########################################
# Redis
########################################
# Redis URL (tick cache, circuit breaker, etc.; Solid Queue uses PostgreSQL)
REDIS_URL=redis://localhost:6379/0

########################################
# Database
########################################
# Production DB user password (only used by production config)
ALGO_SCALPER_API_DATABASE_PASSWORD=

# Alternatively, use a single DATABASE_URL (uncomment and set if preferred)
#DATABASE_URL=postgres://myuser:mypass@localhost:5432/mydatabase

########################################
# DhanHQ Integration
########################################
# Master toggle for DhanHQ integration
DHANHQ_ENABLED=true

# Run trading daemon services (required for live trading loop)
ENABLE_TRADING_SERVICES=true

# Live broker order execution guard (MUST be true for real orders)
PLACE_ORDER=false

# Safety toggles: keep these disabled for live trading
BACKTEST_MODE=0
SCRIPT_MODE=0

# WebSocket mode: quote, etc.
DHANHQ_WS_MODE=quote

# REST base URL for Dhan
DHANHQ_BASE_URL=https://api.dhan.co/v2

# WebSocket API version (integer)
DHANHQ_WS_VERSION=2

# Token acquisition: totp (default) | manual | renew | authority
DHAN_AUTH_MODE=totp

# Required when DHAN_AUTH_MODE=totp
DHAN_PIN=
DHAN_TOTP_SECRET=

# Optional: fetch Dhan token from external authority (e.g. algo_trading_api).
# Set both when using GET /auth/dhan/token with a Bearer token (same as in Postman).
# TRADER_API_BASE_URL= base URL of the API that serves /auth/dhan/token
# DHAN_TOKEN_ACCESS_TOKEN= Bearer token sent to that API
#TRADER_API_BASE_URL=
#DHAN_TOKEN_ACCESS_TOKEN=

# Preferred credential keys
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Fallback credential keys (used if preferred keys are unset)
CLIENT_ID=
ACCESS_TOKEN=

# Optional partner credentials
DHANHQ_PARTNER_ID=
DHANHQ_PARTNER_SECRET=

# Optional WebSocket overrides
DHANHQ_WS_ORDER_URL=
DHANHQ_WS_USER_TYPE=

# Real broker execution (Rails + trading daemon). Unset or false = paper mode (simulated fills,
# GatewayPaper). true = live gateway — real orders if dhanhq.enable_orders is also true in algo.yml.
# ./bin/dev is safe by default: leave false unless you intend to send real orders.
LIVE_TRADING=false

# Fast Supertrend entries for lifecycle/paper testing (bypasses intraday breakout/OI/momentum entry gates only).
# FAST_ENTRY_MODE=false

# Paper research: direction gate auto-off when LIVE_TRADING is false (ranging/choppy entries allowed).
# Set true to keep live-like direction gate behavior in paper mode.
# PAPER_STRICT_DIRECTION_GATE=false

# Signal strictness tier (overrides signals.signal_tier in algo.yml): exploratory | standard | selective
# SIGNAL_TIER=selective

# When signals.tick_ai_analysis_enabled is true, AiTechnicalAnalysisJob skips OPEN market hours
# (tick path owns intraday). Set true to keep the 15m rake job anyway (debug / dual-run).
# SCHEDULED_AI_TECHNICAL_ANALYSIS=true

# Same pattern for Solid Queue SmcScannerJob (15m SMC + long-form AI Telegram).
# SCHEDULED_SMC_SCANNER=true

# Logging for Dhan integration (DHANHQ_LOG_LEVEL takes precedence)
# One of: DEBUG, INFO, WARN, ERROR, FATAL
DHANHQ_LOG_LEVEL=INFO
DHAN_LOG_LEVEL=INFO

# Symbols/instruments to subscribe on Dhan WS in dev
# Accepts comma, semicolon, or newline-separated values
# Example: NIFTY 50; BANKNIFTY; RELIANCE
DHANHQ_WS_WATCHLIST=

########################################
# Deployment (Kamal / Docker)
########################################
# Rails credentials key (required in deployments)
RAILS_MASTER_KEY=

# Docker Compose defaults (optional overrides)
# DATABASE_URL=postgres://postgres:postgres@db:5432/algo_scalper_production
# REDIS_URL=redis://redis:6379/0
# RAILS_ENV=production

# Container registry password for Kamal
KAMAL_REGISTRY_PASSWORD=

# Optional concurrency hint (not explicitly used by Puma here)
#WEB_CONCURRENCY=

########################################
# Telegram Notifications
########################################
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat ID (can be obtained from @userinfobot)
TELEGRAM_CHAT_ID=
########################################
# Trading Daemon Startup Safety
########################################
# Fail trading daemon startup when boot reconciliation fails.
# Default behavior in code: strict=true during market hours, strict=false otherwise.
TRADING_BOOT_RECONCILIATION_STRICT=

# Optional override for market-hours checks (keep false for live)
FORCE_MARKET_OPEN=false

########################################
# Ollama (AI — local or Ollama Cloud)
########################################
# The app uses the `ollama-client` gem only. OpenAI / OPENAI_API_KEY are not used.
# Local vs cloud is toggled in Settings → AI (+ai.ollama_use_cloud+ in algo.yml / DB overrides).
# Base URL for Ollama HTTP API (fallback for both modes if LOCAL/CLOUD URL not set)
OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_LOCAL_URL=http://127.0.0.1:11434
#OLLAMA_HOST_URL=http://localhost:11434
#OLLAMA_CLOUD_URL=https://ollama.com
#OLLAMA_API_KEY=   # required when ollama_use_cloud is true
# Explicit model name (optional; otherwise auto-selected from `ollama list`)
#OLLAMA_MODEL=llama3
#OLLAMA_TIMEOUT=20
#OLLAMA_STREAM_TIMEOUT=120
#OLLAMA_OPEN_TIMEOUT=5
#OLLAMA_REQUEST_DELAY_MS=500
#OLLAMA_MODELS_CACHE_TTL=300

########################################
# Graphify (knowledge graph — dev + optional RAG)
########################################
# Install: uv tool install "graphifyy[ollama,mcp]" && graphify cursor install --project
# AST refresh (no LLM): bin/graphify-update
# Semantic extract: bin/graphify-extract (uses Ollama below)
#GRAPHIFY_OLLAMA_USE_CLOUD=false
#GRAPHIFY_OLLAMA_MODEL=llama3.2
#GRAPHIFY_GRAPH_PATH=graphify-out/graph.json
#GRAPHIFY_TOKEN_BUDGET=2000
#GRAPHIFY_QUERY_TIMEOUT=3
#GRAPHIFY_MCP_URL=http://localhost:8080/mcp
#GRAPHIFY_SECRET=
