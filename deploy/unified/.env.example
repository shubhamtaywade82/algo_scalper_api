# Copy to .env (gitignored) and fill in. Nothing in this file is a real secret.
# Generate secrets with:  openssl rand -hex 24      (SECRET_KEY_BASE: openssl rand -hex 64)
# Encryption keys:        bin/rails db:encryption:init   (run once; losing them makes stored Dhan tokens unreadable)

# --- Postgres (one server; separate roles for the two apps) ---
POSTGRES_PASSWORD=
ASA_DB_PASSWORD=
OTA_DB_PASSWORD=

# --- Rails app (production mode) ---
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Guards GET /api/dhan/token. The agent presents the same value. Long and random; never public.
API_OPERATOR_TOKEN=
# Dashboard tier. Baked into the dashboard bundle at build time, so it must differ from API_OPERATOR_TOKEN and the
# dashboard must only be reachable from a trusted interface (it binds to 127.0.0.1).
API_DASHBOARD_TOKEN=
# Optional: enables settings writes through the API. Empty keeps them disabled in production.
SETTINGS_UPDATE_TOKEN=

# --- Dhan: ONE account for both apps ---
DHAN_CLIENT_ID=
# Only the Rails services get these (they own the login, DH-906). Leave empty until the "trading" profile is used.
DHAN_PIN=
DHAN_TOTP_SECRET=

# --- Live-order gates (keep false/empty until the staged rollout in README.md says otherwise) ---
ASA_PLACE_ORDER=false
OTA_MODE=paper
OTA_LIVE_ACK=

# --- Optional ---
ALERT_WEBHOOK_URL=
# Host ports (loopback only). Change them if 3011/3000 are taken, for example by a dev stack.
ASA_WEB_PORT=3011
DASHBOARD_PORT=3000
# Where the two repos live, relative to this folder. The agent needs its Dockerfile (agent branch feat/docker-image).
ASA_CONTEXT=../..
OTA_CONTEXT=../../../options-trading-agent
