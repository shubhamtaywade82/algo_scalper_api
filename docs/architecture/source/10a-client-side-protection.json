  "cards": [
    {
      "dot": "cyan",
      "title": "Client-side means tick-dependent",
      "items": [
        "Paper and sandbox hold the stop and target in the agent",
        "Without option ticks the stop cannot fire, so the agent watches the silence"
      ]
    },
    {
      "dot": "amber",
      "title": "Entries stop first, then the exit",
      "items": [
        "A stale position refuses entries on its underlying at once",
        "The exit comes only after STALE_POSITION_GRACE_MS"
      ]
    },
    {
      "dot": "rose",
      "title": "The watch measures option silence",
      "items": [
        "Silence is counted from the later of the fill and the last option tick",
        "A quiet strike looks like a dead feed, so keep the grace above typical trade gaps"
      ]
    }
  ]
