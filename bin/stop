#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

stop_pid_file() {
  local file=$1
  local name=$2
  if [[ ! -f "$file" ]]; then
    return 0
  fi

  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    echo "Stopping $name (pid $pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -9 "$pid" 2>/dev/null || true
  else
    echo "Removing stale $name pid file ($pid not running)"
  fi
  rm -f "$file"
}

stop_pid_file "tmp/pids/server.pid" "Puma"
# bin/mcp (ActionMCP) — Puma renames its process, so the pattern match below misses it.
stop_pid_file "tmp/pids/mcp.pid" "MCP server"

stop_project_processes() {
  local pattern=$1
  local label=$2
  mapfile -t pids < <(pgrep -f "$pattern" 2>/dev/null || true)
  for pid in "${pids[@]:-}"; do
    [[ -z "$pid" ]] && continue
    local cwd
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || echo "")"
    [[ "$cwd" != "$ROOT" && "$cwd" != "$ROOT/"* ]] && continue
    echo "Stopping $label (pid $pid)..."
    kill "$pid" 2>/dev/null || true
  done
}

for pattern in \
  "rails server" \
  "rake trading:daemon" \
  "bin/jobs" \
  "dashboard/node_modules/.bin/vite"
do
  stop_project_processes "$pattern" "$(basename "$pattern")"
done

sleep 1

force_stop_project_processes() {
  local pattern=$1
  mapfile -t pids < <(pgrep -f "$pattern" 2>/dev/null || true)
  for pid in "${pids[@]:-}"; do
    [[ -z "$pid" ]] && continue
    local cwd
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || echo "")"
    [[ "$cwd" != "$ROOT" && "$cwd" != "$ROOT/"* ]] && continue
    kill -9 "$pid" 2>/dev/null || true
  done
}

for pattern in \
  "rails server" \
  "rake trading:daemon" \
  "bin/jobs" \
  "dashboard/node_modules/.bin/vite"
do
  force_stop_project_processes "$pattern"
done

# options-trading-agent runs from its own repo (Procfile.dev `agent`), so the cwd filter above skips it. SIGTERM starts
# its graceful shutdown, which closes paper positions through the normal exit path; give it time before forcing.
AGENT_ROOT="$(cd "$ROOT/../options-trading-agent" 2>/dev/null && pwd || true)"
if [[ -n "$AGENT_ROOT" ]]; then
  mapfile -t agent_pids < <(pgrep -f "src/index.tsx" 2>/dev/null || true)
  # npm/sh/tsx wrappers all match the pattern. The agent handles only one SIGTERM (process.once) and tsx relays signals
  # to its child, so signal only the leaf process that runs the app; the wrappers exit with it.
  parents=" $(for pid in "${agent_pids[@]:-}"; do [[ -n "$pid" ]] && ps -o ppid= -p "$pid" 2>/dev/null; done | tr -d ' ' | tr '\n' ' ') "
  live_agents=()
  for pid in "${agent_pids[@]:-}"; do
    [[ -z "$pid" ]] && continue
    [[ "$(readlink -f "/proc/$pid/cwd" 2>/dev/null)" == "$AGENT_ROOT" ]] || continue
    [[ "$parents" == *" $pid "* ]] && continue
    echo "Stopping options-trading-agent (pid $pid)..."
    kill "$pid" 2>/dev/null || true
    live_agents+=("$pid")
  done
  for _ in $(seq 1 60); do
    alive=0
    for pid in "${live_agents[@]:-}"; do [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && alive=1; done
    [[ $alive -eq 0 ]] && break
    sleep 1
  done
  for pid in "${live_agents[@]:-}"; do
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && { echo "Warning: agent pid $pid did not stop in 60s, forcing"; kill -9 "$pid" 2>/dev/null || true; }
  done
fi

if command -v ss >/dev/null 2>&1; then
  for port in 3011 62770; do
    if ss -tlnp 2>/dev/null | grep -q ":$port"; then
      echo "Warning: port $port still in use. Run: ss -tlnp | grep $port"
    fi
  done
fi

echo "Done. Start fresh with: ./bin/dev"
