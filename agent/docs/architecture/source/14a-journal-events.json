  "cards": [
    {
      "dot": "rose",
      "title": "Durable before the broker",
      "items": [
        "entry_submitted is awaited before the entry is sent (underlyingAgent.ts:658)",
        "exit_submitted is attempted before the sell, and a failed write becomes audit_gap; the exit still goes out",
        "trade_closed is durable so a standby restores the realised P&L"
      ]
    },
    {
      "dot": "amber",
      "title": "A failed write is recorded",
      "items": [
        "audit_gap marks an exit whose intent could not be written; the exit still goes out",
        "Unconfirmed events hold new entries until the record is written"
      ]
    },
    {
      "dot": "cyan",
      "title": "Restart rebuilds the day from these events",
      "items": [
        "Day P&L, trade count, cooldown and breach state come from today's file or ledger",
        "A malformed line refuses startup"
      ]
    }
  ]
