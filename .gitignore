# Standard Rails pattern: ignore directory CONTENTS but keep the dirs in git
# (log/.keep, tmp/.keep) so fresh checkouts — and the Docker build, which
# chowns db log storage tmp — always have the runtime directories.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/.keep
coverage/
spec/failed_examples.txt
/failed_examples*.txt
/rspec_out*.txt
/spec_failure.txt
/temp_rspec_output.txt
.env
.env*.local

# Node sidecar
node-sidecar/node_modules/
node-sidecar/dist/
node-sidecar/.env

# Next.js dashboard
dashboard/node_modules/
dashboard/.next/
dashboard/out/

# System and editor files
.DS_Store
*.swp
*.swo

# Graphify codebase index (regenerated locally, not needed in git)
graphify-out/
.worktrees/
.railsforge
