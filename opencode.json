        "/home/nemesis/.rvm/gems/ruby-4.0.6/bin/rails-mcp-server",
        "--single-project"
      ],
      "enabled": true
    },
    "railsforge": {
      "type": "local",
      "command": [
        "node",
        "/home/nemesis/.cursor-server/extensions/shubhamtaywade.railsforge-0.1.4/dist/mcp/server.js"
